{
  "name": "blackbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:check": "cross-env DB_TARGET=development tsx --conditions=react-server --env-file=.env.local scripts/db-check.ts",
    "db:check:prod": "cross-env DB_TARGET=production tsx --conditions=react-server --env-file=.env.local scripts/db-check.ts",
    "db:query": "cross-env DB_TARGET=development tsx --conditions=react-server --env-file=.env.local scripts/db-query.ts",
    "db:query:prod": "cross-env DB_TARGET=production tsx --conditions=react-server --env-file=.env.local scripts/db-query.ts",
    "db:grants:prod": "cross-env DB_TARGET=production tsx --conditions=react-server --env-file=.env.local scripts/db-query.ts --file scripts/sql/grants.sql",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:migrate:prod": "cross-env MIGRATE_TARGET=production node --env-file=.env.local scripts/migrate.mjs",
    "db:studio": "cross-env DRIZZLE_TARGET=development drizzle-kit studio",
    "db:studio:prod": "cross-env DRIZZLE_TARGET=production drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "db:bundle": "node scripts/bundle-schema.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@tanstack/react-table": "9.2.4",
    "ai": "7.0.97",
    "better-auth": "1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.87.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.3.0"
}
