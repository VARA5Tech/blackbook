# ---------------------------------------------------------------- databases
#
# Two variables, one meaning each. Nothing silently falls back between them,
# because the production URL is allowed to sit on a developer's machine so
# migrations can be applied from a laptop.
#
#   DEV_DATABASE_URL   local Postgres. Used by `pnpm dev`, the tests and every
#                      `db:*` command without a `:prod` suffix.
#   DATABASE_URL       the live database. Set in Dokploy. Reached locally only
#                      by the `db:*:prod` commands, which say so in their name.

DEV_DATABASE_URL="postgresql://vara5:vara5_local_dev@localhost:5433/vara5_crm"
DATABASE_URL=""

# The live database as reached from a laptop, through a tunnel. Optional, and
# never set in Dokploy: the server does not need a tunnel to talk to itself.
#
# DATABASE_URL's host is a container name, so it resolves on the server and
# nowhere else. That is deliberate, and it also means no one can read the live
# database to diagnose anything. A tunnel gives back the reading without
# publishing Postgres to the internet. See docs/production-access.md.
#
# The port is local; the database is not. `db:*:prod` prefers this, the test
# suite and the seed refuse it outright, and the running application never
# looks at it.
PROD_TUNNEL_DATABASE_URL=""

# There is no Supabase API variable here on purpose. This application talks to
# Postgres directly and runs its own SQL. SUPABASE_URL and the service key reach
# PostgREST, which cannot run transactions, migrations, or the ranked and
# fuzzy search this depends on, so they are not an alternative to the line above.

# ---------------------------------------------------------------------- auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production must use its own secret. Never reuse the development one.
BETTER_AUTH_SECRET=""

# The origin the app is served from. Must match exactly, including the scheme:
# a mismatch is the usual cause of a sign-in that succeeds then bounces back.
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------ AI
# One OpenRouter key reaches every model, so changing model needs no new key.
OPENROUTER_API_KEY=""
AI_MODEL="deepseek/deepseek-v4.1-flash"

# --------------------------------------------------------------- diagnostics
# Set to true to print every SQL query to the server console.
DB_LOG="false"
# debug | info | warn | error. Defaults to debug locally, info in production.
LOG_LEVEL=""
