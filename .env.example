# ---------------------------------------------------------------- databases
#
# Two variables, one meaning each. Nothing silently falls back between them,
# because the production URL is allowed to sit on a developer's machine.
#
#   DEV_DATABASE_URL   local Postgres. Used by `pnpm dev`, the tests and every
#                      `db:*` command.
#   DATABASE_URL       the live database, as the deployed container addresses
#                      it. Set in Dokploy. Its host is a Docker container name,
#                      so it resolves on the server and nowhere else; a laptop
#                      cannot open it and nothing here tries. To read production
#                      locally, see operator access below.

DEV_DATABASE_URL="postgresql://vara5:vara5_local_dev@localhost:5433/vara5_crm"
DATABASE_URL=""

# ------------------------------------------------- operator access (local only)
#
# Not application configuration. The deployed app never reads these, and they
# must not be set in Dokploy.
#
# The production database has no public Postgres port, by design: DATABASE_URL
# names a Docker container. But the Supabase stack sharing that database is
# published over HTTPS, and these reach it, which is how `pnpm db:query:prod`
# reads production from a laptop without a tunnel or an open port.
#
# SUPABASE_SERVICE_ROLE_KEY is a root credential, not a read key: it reaches
# /pg/query, which executes arbitrary SQL as `postgres`, schema included. Keep
# it out of any browser bundle, out of NEXT_PUBLIC_*, and out of the repository.
SUPABASE_URL="https://crmdb.vara5.travel"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------- auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production must use its own secret. Never reuse the development one.
BETTER_AUTH_SECRET=""

# The origin the app is served from. Must match exactly, including the scheme:
# a mismatch is the usual cause of a sign-in that succeeds then bounces back.
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------ AI
# One OpenRouter key reaches every model, so changing model needs no new key.
OPENROUTER_API_KEY=""
AI_MODEL="deepseek/deepseek-v4.1-flash"

# --------------------------------------------------------------- diagnostics
# Set to true to print every SQL query to the server console.
DB_LOG="false"
# debug | info | warn | error. Defaults to debug locally, info in production.
LOG_LEVEL=""

# --------------------------------------------------------------------- email
# Resend, for password reset codes sent from blackbook@vara5.travel. The
# vara5.travel domain must be verified in Resend, and a send-only key is enough. Without a
# key, development prints each email to the terminal and production reports an
# error rather than silently sending nothing.
RESEND_API_KEY=""

# ------------------------------------------------------------ private access
# Shared with the vara5.travel website, which signs each lookup with it before
# sending a guest a WhatsApp code. The website must hold the same value. At
# least 32 characters; without it the lookup answers 503 and nobody gets a code.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRIVATE_ACCESS_SECRET=""
