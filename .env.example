# ---------------------------------------------------------------- databases
#
# Two variables, one meaning each. Nothing silently falls back between them,
# because the production URL is allowed to sit on a developer's machine.
#
#   DEV_DATABASE_URL   local Postgres. Used by `pnpm dev`, the tests and every
#                      `db:*` command.
#   DATABASE_URL       the live database, as the deployed container addresses
#                      it. Set in Dokploy. Its host is a Docker container name,
#                      so it resolves on the server and nowhere else; a laptop
#                      cannot open it and nothing here tries. To read production
#                      locally, see operator access below.

DEV_DATABASE_URL="postgresql://vara5:vara5_local_dev@localhost:5433/vara5_crm"
DATABASE_URL=""

# ------------------------------------------------- operator access (local only)
#
# Not application configuration. The deployed app never reads these, and they
# must not be set in Dokploy.
#
# The production database has no public Postgres port, by design: DATABASE_URL
# names a Docker container. But the Supabase stack sharing that database is
# published over HTTPS, and these reach it, which is how `pnpm db:query:prod`
# reads production from a laptop without a tunnel or an open port.
#
# SUPABASE_SERVICE_ROLE_KEY is a root credential, not a read key: it reaches
# /pg/query, which executes arbitrary SQL as `postgres`, schema included. Keep
# it out of any browser bundle, out of NEXT_PUBLIC_*, and out of the repository.
SUPABASE_URL="https://crmdb.vara5.travel"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------- auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production must use its own secret. Never reuse the development one.
BETTER_AUTH_SECRET=""

# The origin the app is served from. Must match exactly, including the scheme:
# a mismatch is the usual cause of a sign-in that succeeds then bounces back.
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------ AI
# One OpenRouter key reaches every model, so changing model needs no new key.
OPENROUTER_API_KEY=""
AI_MODEL="deepseek/deepseek-v4.1-flash"

# --------------------------------------------------------------- diagnostics
# Set to true to print every SQL query to the server console.
DB_LOG="false"
# debug | info | warn | error. Defaults to debug locally, info in production.
LOG_LEVEL=""

# --------------------------------------------------------------------- email
# Resend, for password reset codes sent from blackbook@vara5.travel. The
# vara5.travel domain must be verified in Resend, and a send-only key is enough. Without a
# key, development prints each email to the terminal and production reports an
# error rather than silently sending nothing.
RESEND_API_KEY=""

# Where mail goes when this is not production.
#
# Development runs against a copy of the live database, so the curator, the
# managers and the administrators a lead mails are real colleagues. Outside
# production every message is re-addressed to this one mailbox and its copies
# are dropped, with the intended recipient shown in the subject. Leave it
# empty and nothing is sent at all: the message is printed to the terminal
# instead. Never set this in production, where it is ignored.
DEV_EMAIL_TO=""

# ------------------------------------------------------------ private access
# Shared with the vara5.travel website, which signs each lookup with it before
# sending a guest a WhatsApp code. The website must hold the same value. At
# least 32 characters; without it the lookup answers 503 and nobody gets a code.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRIVATE_ACCESS_SECRET=""

# ------------------------------------------------------------------- posthog
# Read-only. Blackbook sends nothing to PostHog; vara5.travel does that and
# reports what the desk needs straight into the database, so the Interest panel
# works with these blank. They only add the links to session replays.
#
# A personal API key can read the whole project, so treat it as an operator
# credential: server-side only, never NEXT_PUBLIC_, never in the website's
# bundle. Create it under Settings, Personal API keys, with the "Query read"
# and "Session recording read" scopes and nothing else.
POSTHOG_PROJECT_ID=""
POSTHOG_API_KEY=""
# US Cloud by default. EU Cloud is https://eu.posthog.com. Not the `.i.` host:
# that one is for ingestion and does not serve the private API.
POSTHOG_API_HOST="https://us.posthog.com"

# ------------------------------------------------------------ Tern bridge
# Where the Tern bridge answers (tern-bridge/ in this repository), running on
# the office machine beside a Chrome signed in to Tern. Blackbook asks it for
# one client at a time when somebody presses Populate; it never holds a Tern
# password or cookie. Leave both empty and the Tern buttons do not appear.
# The secret must match the bridge's own TERN_BRIDGE_SECRET, 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TERN_BRIDGE_URL=""
TERN_BRIDGE_SECRET=""
# Optional: a Cloudflare Access service token in front of the bridge's tunnel.
# With it, the bridge's hostname refuses anybody without the token.
TERN_BRIDGE_ACCESS_ID=""
TERN_BRIDGE_ACCESS_SECRET=""

# ------------------------------------------------------------ travel documents
# Seals passport numbers and secure travel numbers (Known Traveler, Redress)
# before they reach the database. 32 bytes, as 64 hex characters or base64.
# Without it, passport details from Tern are not stored at all.
#
# LOSE THIS KEY AND EVERY SEALED NUMBER IS GONE. Keep a copy somewhere that is
# not this server, never commit it, and never change it without re-sealing.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=""

# ------------------------------------------------------------ document storage
# Files the desk attaches to a client: scans, itineraries, visas. Optional —
# with STORAGE_BUCKET unset the documents card never appears and nothing else
# changes.
#
# This is the one place the app talks to Supabase over HTTP rather than SQL,
# and it is a separate service on a separate path (/storage/v1). Files are not
# relational data, so none of the reasons the database is reached over a
# connection string apply; see the note in src/lib/storage.ts. It reuses
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above — server-side only, never in
# a browser bundle. The same two point at a self-hosted or hosted Supabase.
#
# Dashboard: Studio -> Storage -> New bucket -> name it below -> Private.
STORAGE_BUCKET="blackbook-documents"
