# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# typescript
*.tsbuildinfo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment. Real values never get committed, but the template must be, or
# nobody knows what the application needs.
.env
.env.*
!.env.example

# Coding-agent instructions, not part of the product. AGENTS.md is generated and
# re-added by `next dev`; CLAUDE.md is hand-written guidance for Claude Code.
# Kept out of the repository at the owner's request.
CLAUDE.md
AGENTS.md
